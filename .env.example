# ── Supabase (persistence, chat logging, RAG) ─────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini via OpenAI-compatible endpoint (live agent chat) ───────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash
GEMINI_GUARDRAIL_MODEL=gemini-3.5-flash-lite

# Embeddings for the RAG knowledge base.
# GEMINI_EMBEDDING_DIMENSIONS must equal `vector(n)` in supabase/schema-vector.sql.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# Thinking level for the main model ("low" caps hidden-token cost on routine answers).
GEMINI_REASONING_EFFORT=low
